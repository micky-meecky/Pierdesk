@{
    # Local-only release signing & update mirror settings.
    # Copy this file to scripts\update-release.local.psd1 (git-ignored) and fill in your values.

    # Path to the Ed25519 PKCS#8 private key generated by:
    #   .\scripts\publish-update-release.ps1 -InitKey
    # Keep this file outside the git repository and back it up securely.
    SigningKeyPath = '%LOCALAPPDATA%\ClipFerry\release-signing\update-signing.pk8'

    # Base64-encoded 32-byte Ed25519 public key printed by -InitKey.
    # Baked into release binaries during packaging so clients verify every manifest offline.
    UpdatePublicKey = ''

    # Public HTTPS base URL for the primary download mirror (Cloudflare Worker proxy or R2 custom domain).
    # Example: 'https://downloads.example.com'
    MirrorBaseUrl = ''

    # Manifest URL baked in as the primary source (falls back automatically to GitHub Releases).
    # Example: 'https://downloads.example.com/updates/stable.json'
    PrimaryManifestUrl = ''

    # Optional: set only if you later enable Cloudflare R2 and want automatic `wrangler r2` uploads.
    # Leave empty when using the free Cloudflare Worker proxy in front of GitHub Releases.
    R2Bucket = ''

    # GitHub repository used for fallback binary/manifest links and release notes.
    GitHubRepo = 'micky-meecky/Pierdesk'
}
